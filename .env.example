# Copy to .env.local for local development. Put the same values in Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Telegram → Groq work logging (server-only). TELEGRAM_ALLOWED_CHAT_IDS is optional
# but strongly recommended; separate multiple personal chat IDs with commas.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=a-1-to-256-character-secret_using-only_A-Z_a-z_0-9_- 
TELEGRAM_ALLOWED_CHAT_IDS=123456789
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
WORK_DURATION_TIMEZONE=Asia/Makassar
